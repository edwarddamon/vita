<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vita.auth.mapper.RoleMapper">

    <select id="describeUserRoles" resultType="com.vita.auth.entity.Role">
        SELECT
            sr.code,
            sr.name,
            sr.data_auth
        FROM sys_role sr
                 JOIN inf_user_role_rel iurr ON sr.id = iurr.id
        WHERE sr.del_flag = 0;
    </select>
</mapper>
